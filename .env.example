TOKEN=
CLIENT_ID=

# 저장형 `/오늘운세` 프로필 암호화(AES-256-GCM). 32바이트를 base64로 인코딩한 값.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
FORTUNE_PROFILE_ENCRYPTION_KEY_BASE64=

# 선택: `/상태` 공개 패널에 홈페이지 응답 시간만 표시(https). URL 문자열은 메시지에 출력하지 않습니다.
MINE_STATUS_HOMEPAGE_URL=

# 선택: Soundroom 대기·재생 폴백용 유휴 GIF(https). 비우면 레포의 docs/mine_soundroom_logo_loop_480.gif가 있을 때만 첨부로 사용합니다.
# 예(본 레포 main 기준): https://raw.githubusercontent.com/adgjmptw2/MINE-Discord-Bot/main/docs/mine_soundroom_logo_loop_480.gif
SOUNDROOM_IDLE_GIF_URL=

# Optional: guild id(s) for INSTANT slash while global syncs. Comma-separated ok. Global slash is still updated (old junk like /247 is overwritten); other servers may take up to ~1h to show commands.
DEV_GUILD_ID=

# Optional: "true" = next start wipes commands on the route above then re-registers. With DEV_GUILD_ID, reset also clears global in one pass.
RESET_SLASH_COMMANDS_ON_START=

# Required for /melon_chart (인기차트-관리): comma-separated user IDs who may set the ONE global chart playlist for every guild.
DISCORD_OWNER_IDS=

# Lavalink
# Folder that contains Lavalink.jar (see lavalink/README.md — place JAR next to application.yml)
# Example: C:\Users\you\MINE-Discord-main\lavalink
LAVALINK_JAR_DIR=
LAVALINK_NAME=mine-main
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_ENGINE=ytsearch
# Optional JVM heap flags for start:lavalink / start:all (default -Xms512m -Xmx1536m)
# LAVALINK_JAVA_OPTS=-Xms512m -Xmx1536m

# Sharding
SHARD_COUNT=1
SHARD_LIST=

# Stock mock investment (Twelve Data prepared; DB/commands not in step 1)
TWELVE_DATA_API_KEY=
STOCK_PRICE_PROVIDER=mock
# mock | twelvedata | yahoo
# yahoo는 국내주식 MVP 검증용 demo/delayed quote provider입니다. 실제 투자용 데이터가 아닙니다.
# STOCK_PRICE_REFRESH_MODE: interval (default) | scheduled-close
# interval: poll every STOCK_PRICE_REFRESH_INTERVAL_MS
# scheduled-close: KST weekday only, at times in STOCK_SCHEDULED_CLOSE_REFRESH_TIMES_KST (comma-separated HH:mm)
STOCK_PRICE_REFRESH_MODE=interval
STOCK_SCHEDULED_CLOSE_REFRESH_TIMES_KST=15:31,15:35,15:40,16:00

# 모의 주식 거래 시간 (KST, 토·일만 막음. 공휴일 미반영)
# false: 24시간 /매수 /매도 가능
STOCK_TRADING_HOURS_ENABLED=false
STOCK_TRADING_START_KST=09:00
STOCK_TRADING_END_KST=15:30
# 매수·매도 수수료율 및 매도 거래세율 (0 이상 0.1 이하, 범위 밖이면 기본값)
STOCK_BUY_FEE_RATE=0.00015
STOCK_SELL_FEE_RATE=0.00015
STOCK_SELL_TAX_RATE=0.002
