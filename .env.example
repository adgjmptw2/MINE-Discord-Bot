TOKEN=
CLIENT_ID=

# Optional: guild id(s) for INSTANT slash while global syncs. Comma-separated ok. Global slash is still updated (old junk like /247 is overwritten); other servers may take up to ~1h to show commands.
DEV_GUILD_ID=

# Optional: "true" = next start wipes commands on the route above then re-registers. With DEV_GUILD_ID, reset also clears global in one pass.
RESET_SLASH_COMMANDS_ON_START=

# Required for /melon_chart (인기차트-관리): comma-separated user IDs who may set the ONE global chart playlist for every guild.
DISCORD_OWNER_IDS=

# Lavalink
LAVALINK_NAME=mine-main
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_ENGINE=ytsearch

# Sharding
SHARD_COUNT=1
SHARD_LIST=

# Stock mock investment (Twelve Data prepared; DB/commands not in step 1)
TWELVE_DATA_API_KEY=
STOCK_PRICE_PROVIDER=mock
# mock | twelvedata | yahoo
# yahoo는 국내주식 MVP 검증용 demo/delayed quote provider입니다. 실제 투자용 데이터가 아닙니다.
# STOCK_PRICE_REFRESH_MODE: interval (default) | scheduled-close
# interval: poll every STOCK_PRICE_REFRESH_INTERVAL_MS
# scheduled-close: KST weekday only, at times in STOCK_SCHEDULED_CLOSE_REFRESH_TIMES_KST (comma-separated HH:mm)
STOCK_PRICE_REFRESH_MODE=interval
STOCK_SCHEDULED_CLOSE_REFRESH_TIMES_KST=15:31,15:35,15:40,16:00
